pkgname=firmware-nothing-pong
pkgver=20250103
pkgrel=1
pkgdesc="Firmware for Nothing Phone (2)"
subpackages="
	$pkgname-adreno
	$pkgname-adsp
	$pkgname-cdsp
	$pkgname-hexagonfs
	$pkgname-slpi
	$pkgname-ipa
	$pkgname-modem
	$pkgname-venus
	"
url="https://github.com/mainlining/firmware-nothing-pong"
arch="aarch64"
license="proprietary"
makedepends="pil-squasher"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
_commit="0e5940ff3c3486f7146f864dd288b85809e445af"
source="$pkgname-$_commit.tar.gz::$url/archive/$_commit/$pkgname-$_commit.tar.gz"
builddir="$srcdir/$pkgname-$_commit"
resultdir="lib/firmware/qcom/sm8475/nothing/pong"

build() {
	for i in firmware/*.mdt; do
		pil-squasher "firmware/$(basename "$i" .mdt)".mbn "$i"
	done
}

package() {
	# parent package is empty
	mkdir -p "$pkgdir"
}

adreno() {
	pkgdesc="Nothing Phone (2) adreno firmware"

	install -Dm644 "$builddir"/firmware/a730_zap.mbn -t \
		"$subpkgdir/$resultdir/"
}

adsp() {
	pkgdesc="Nothing Phone (2) adsp firmware"

	install -Dm644 "$builddir"/firmware/adsp.mbn -t \
		"$subpkgdir/$resultdir/"
	install -Dm644 "$builddir"/firmware/adsp*.jsn -t \
		"$subpkgdir/$resultdir/"
	install -Dm644 "$builddir"/firmware/battmgr.jsn -t \
		"$subpkgdir/$resultdir/"
}

cdsp() {
	pkgdesc="Nothing Phone (2) cdsp firmware"

	install -Dm644 "$builddir"/firmware/cdsp.mbn -t \
		"$subpkgdir/$resultdir/"
	install -Dm644 "$builddir"/firmware/cdsp*.jsn -t \
		"$subpkgdir/$resultdir/"
}

hexagonfs() {
	pkgdesc="Nothing Phone (2) hexagonfs files"

	mkdir -p "$subpkgdir/usr/share"

	cp -r "$builddir/hexagonfs" \
		"$subpkgdir/usr/share/qcom"
	find "$subpkgdir/usr/share/qcom/" \
		-type f -exec chmod 0644 {} \;
}

slpi() {
	pkgdesc="Nothing Phone (2) slpi firmware"

	install -Dm644 "$builddir"/firmware/slpi.mbn -t \
		"$subpkgdir/$resultdir/"
	install -Dm644 "$builddir"/firmware/slpi*.jsn -t \
		"$subpkgdir/$resultdir/"
}

ipa() {
	pkgdesc="Nothing Phone (2) ipa firmware"

	install -Dm644 "$builddir"/firmware/ipa_fws.mbn \
		"$subpkgdir/$resultdir/ipa_fws.mbn"
}

modem() {
	pkgdesc="Nothing Phone (2) modem firmware"

	install -Dm644 "$builddir"/firmware/modem.mbn -t \
		"$subpkgdir/$resultdir/"
	install -Dm644 "$builddir"/firmware/modem*.jsn -t \
		"$subpkgdir/$resultdir/"

	cp -r "$builddir"/firmware/modem_pr/ \
		"$subpkgdir/$resultdir/"
	find "$subpkgdir/$resultdir/" \
		-type f -exec chmod 0644 {} \;
}

venus() {
	pkgdesc="Nothing Phone (2) venus firmware"

	install -Dm644 "$builddir"/firmware/venus.mbn \
		"$subpkgdir/$resultdir/venus.mbn"
}

sha512sums="
611ed6e42192d42f6127319a06001b92886dd459efdc5bf9743c5250bb2fff5696582b8c61f2d1f50d76deaadba3f58de71d23022ffbcfdab27df8c387670e91  firmware-nothing-pong-0e5940ff3c3486f7146f864dd288b85809e445af.tar.gz
"
