# Maintainer: Jens Reidel <adrian@travitia.xyz>
# Reference: <https://postmarketos.org/devicepkg>

pkgname=device-qcom-sc7280
pkgdesc="Generic device package for Qualcomm SC7280 devices"
pkgver=1
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	bootmac
	hexagonfs-firmware-loader
	hexagonrpcd
	linux-firmware-qca
	linux-firmware-qcom
	linux-postmarketos-qcom-sc7280
	make-dynpart-mappings
	msm-firmware-loader
	msm-modem
	msm-modem-uim-selection
	postmarketos-base
	qbootctl
	swclock-offset
	systemd-boot
	tqftpserv
	unl0kr-fbforcerefresh
"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-openrc
"

source="
	30-initramfs-firmware.files
	deviceinfo
	hexagonrpcd.confd
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/30-initramfs-firmware.files -t \
		"$pkgdir"/usr/share/mkinitfs/files

	install -Dm644 "$srcdir"/hexagonrpcd.confd \
		"$pkgdir"/usr/share/hexagonrpcd/hexagonrpcd-adsp-sensorspd.conf
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install"
	depends="
		hexagonrpcd-openrc
		qbootctl-openrc
		tqftpserv-openrc
		"

	mkdir -p "$subpkgdir"
}

